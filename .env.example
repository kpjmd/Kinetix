# Anthropic
ANTHROPIC_API_KEY=your_anthropic_key_here

# Moltbook
MOLTBOOK_API_KEY=your_moltbook_key_here
MOLTBOOK_USERNAME=Kinetix

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_token_here
TELEGRAM_ADMIN_ID=your_telegram_user_id_here

# CDP / AgentKit Wallet — used for $KINETIX/ETH/USDC payments (wallet/agentkit.js)
CDP_API_KEY_ID=your_cdp_api_key_id_here
CDP_API_KEY_SECRET=your_cdp_api_key_secret_here
CDP_WALLET_SECRET=your_cdp_wallet_secret_here
# Selects the network for the payment/wallet layer (hyphenated). Must match
# DEFAULT_NETWORK below or utils/network.js will refuse to run.
NETWORK_ID=base-sepolia

# Attestation / ERC-8004 identity signing wallet — separate from the CDP
# wallet above. Accepts a 0x-prefixed or bare 64-hex-character private key.
KINETIX_SIGNING_KEY=your_signing_private_key_here
# Selects the network for the EAS/ERC-8004 attestation layer (underscored).
# Must match NETWORK_ID above.
DEFAULT_NETWORK=base_sepolia

# RPC endpoints used by the attestation/ERC-8004 scripts
BASE_MAINNET_RPC_URL=https://mainnet.base.org
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# x402 paid verification server (api/x402/server.js, `npm run x402:start`).
# Deployed as its own service — see docs/OKX_ASP_LISTING.md.
# The address x402 payments are sent to. Must be set explicitly in production;
# the hardcoded fallback is only a development convenience.
CDP_WALLET_ADDRESS=0x8c61756f693A321777562433E19B2AabF71f5519
# Local port only. Railway injects $PORT, which takes precedence.
X402_PORT=3001
# Disables payment validation entirely — never true in production. The boot
# guard refuses to start if this is set while NODE_ENV=production.
X402_TEST_MODE=false
TESTNET_MODE=false
# Arms the production boot guard independently of NODE_ENV.
OKX_LISTED=false

# Persistent storage for commitments and attestations. Without this the data
# store falls back to ./data, which is ephemeral on Railway — every redeploy
# loses issued receipts and the free attestation lookup starts 404ing.
DATA_DIR=/data

# OrthoIQ Backend
ORTHOIQ_API_URL=your_railway_api_url_here
ORTHOIQ_API_KEY=your_railway_api_key_here

# Clawstr (Nostr)
CLAWSTR_ENABLED=true
CLAWSTR_SECRET_KEY_PATH=~/.clawstr/secret.key

# Settings
POSTING_MODE=approval
DAILY_SPEND_LIMIT_USDC=10.00
MAX_SINGLE_TRANSACTION_USDC=2.00
